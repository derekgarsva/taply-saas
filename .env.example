# ==============================================================================
# TAPLY SAAS - ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# 1. Supabase Connection (Database & Storage)
# Obtén estas credenciales en tu panel de Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. SuperAdmin Master Passcode
# PIN maestro para acceder a /admin (por defecto 548282)
TAPLY_ADMIN_PASSCODE=548282

# 3. Next.js App URL
NEXT_PUBLIC_APP_URL=https://taply.xyz
